# Secrets for the vllm-ray-inference-server pattern.
#
# NEVER commit real values to git. Copy this file outside the repository and edit the copy:
#
#   mkdir -p ~/.config/validated-patterns
#   cp values-secret.yaml.template \
#      ~/.config/validated-patterns/values-secret-vllm-ray-inference-server.yaml
#
# `./pattern.sh make install` and `./pattern.sh make load-secrets` load the first file they
# find; when you have no file of your own they fall back to this template.
#
# Secrets documentation:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
# File format:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"

secrets:
  # Hugging Face access token. Loaded into Vault at secret/data/hub/hfmodel (property
  # hftoken), then copied by the ExternalSecret huggingface-secret into the Secret
  # huggingface-secret in namespace rhvp-inference, which the server reads as HF_TOKEN.
  #
  # The default model (Qwen/Qwen2.5-0.5B-Instruct) is not gated, so it needs no token,
  # and the placeholder "none" is enough. Keep a non-empty value: an empty or null value
  # makes the secrets loader stop with an error.
  #
  # For a gated or private model, replace "none" with your token (it starts with "hf_"),
  # or read it from a file instead of the value line:
  #       path: ~/.config/validated-patterns/hftoken
  - name: hfmodel
    fields:
      - name: hftoken
        onMissingValue: error
        value: "none"
