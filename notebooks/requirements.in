# Top-level Python packages for the notebook image. Every other package is resolved from these lines into
# requirements.lock, hash-locked, for both CPU types (x86_64 and aarch64), wheels only:
#
#   uv pip compile requirements.in --universal --python-version 3.12 \
#       --only-binary :all: --generate-hashes -o requirements.lock
#
# The Containerfile installs requirements.lock with --only-binary :all: --require-hashes.
