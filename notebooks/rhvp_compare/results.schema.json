{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhvp-image-compare:results:2",
  "title": "Image comparison results",
  "description": "One run of the image comparison: the plan declared before the first launch, every launch as measured, and the paired analysis. Written by rhvp_compare after every launch to <results root>/<run.id>/results.json (on OpenShift the results volume, mounted at /results); `run.status` says whether the run finished and `run.error_code` why it did not. Times are UTC (RFC 3339); durations are seconds unless the key says ms. A launch is one start of one server; a round launches every entry of the lineup (A, A~same, B, B~same) once. Side A is the baseline, side B the subject; every ratio is B/A. $defs/status describes the separate status.json document (ConfigMap compare-<run id>).",
  "type": "object",
  "required": [
    "schema",
    "run",
    "plan",
    "provenance",
    "launches",
    "analysis"
  ],
  "properties": {
    "schema": {
      "const": "rhvp-image-compare/2",
      "description": "The schema name and major version. A reader checks it first."
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "error_code",
        "started_at",
        "finished_at",
        "platform",
        "server_restored",
        "notes",
        "errors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "runName plus the first 8 hex digits of the config's sha256: a changed config is a new run."
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "partial",
            "failed"
          ],
          "description": "complete: every planned launch finished, with every load level usable; partial: the run ended with failed or missing launches, or with load levels where requests failed; failed: the run stopped on an error before the end; running: still going, or the runner died (see finished_at)."
        },
        "error_code": {
          "enum": [
            null,
            "LAUNCHES_FAILED",
            "REQUESTS_FAILED",
            "STOPPED",
            "RUN_TIMEOUT",
            "RUNNER_FAILED"
          ],
          "description": "null when every planned launch finished. LAUNCHES_FAILED: every launch ran and some failed (partial); REQUESTS_FAILED: every launch ran, but at some load level of some launch requests failed or none finished, and that level is left out (partial); STOPPED: stopped by SIGTERM, for example a deleted Job (partial); RUN_TIMEOUT: stopped near the Job's time limit (partial); RUNNER_FAILED: the run failed outside a launch, for example before the first one (failed). A config that cannot be run (PLAN_INVALID), and a run that found another comparison running (RUN_ACTIVE), write no results file; those codes appear only in the log summary and the termination message."
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "enum": [
            "openshift",
            "docker"
          ]
        },
        "server_restored": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the live server the backend took away for the run is back: on OpenShift the pattern's server Deployment scaled back (and read back), under docker the container named in RHVP_COMPARE_SERVER_CONTAINER started again. null when nothing was taken away (or not yet asked back); false makes the runner exit 4."
        },
        "server_found_down": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when the live server was running when the run began but had stopped by itself before the backend came to take it away: its state then (under docker the container's status, such as exited, or gone when the container had been removed). The backend left it as it was, so nothing brings it back after the run and server_restored stays null; run.notes, results.md and the log say so too. null otherwise; files written before this field existed do not have it."
        },
        "synthetic": {
          "type": "boolean",
          "description": "true only in made-up example files (the notebook's REPLAY file); such a file is not a measurement."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "provenance": {
      "type": "object",
      "required": [
        "harness",
        "load_tool",
        "seeds",
        "sides",
        "gpu",
        "node",
        "cluster"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "required": [
            "name",
            "version"
          ]
        },
        "load_tool": {
          "type": "object",
          "required": [
            "name",
            "image",
            "version"
          ],
          "properties": {
            "name": {
              "const": "guidellm"
            },
            "image": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "As GuideLLM's report states it."
            }
          }
        },
        "seeds": {
          "type": "object",
          "required": [
            "load",
            "server"
          ],
          "properties": {
            "load": {
              "type": "integer"
            },
            "server": {
              "type": "integer"
            }
          }
        },
        "sides": {
          "type": "object",
          "required": [
            "A",
            "B"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/side_provenance"
            },
            "B": {
              "$ref": "#/$defs/side_provenance"
            }
          },
          "description": "Per side; a twin runs its side's image, so it has no entry of its own."
        },
        "gpu": {
          "type": [
            "object",
            "null"
          ],
          "description": "The GPU the sides ran on, from the node's GPU feature labels (OpenShift) or nvidia-smi (docker).",
          "properties": {
            "product": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver": {
              "type": [
                "string",
                "null"
              ]
            },
            "cuda_driver": {
              "type": [
                "string",
                "null"
              ]
            },
            "memory_mib": {
              "type": [
                "integer",
                "null"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ]
            },
            "source": {
              "type": "string"
            }
          }
        },
        "node": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "arch": {
              "type": [
                "string",
                "null"
              ]
            },
            "instance_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "os_image": {
              "type": [
                "string",
                "null"
              ]
            },
            "kernel": {
              "type": [
                "string",
                "null"
              ]
            },
            "container_runtime": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "nodes": {
          "type": "array",
          "description": "Every node and GPU a launch ran on, in the order first seen (node and gpu above keep the first). More than one node gives every case NO VERDICT (more_than_one_node).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "gpu"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gpu": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "cluster": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "openshift_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "launches": {
      "type": "array",
      "description": "Every launch that ran, in run order.",
      "items": {
        "$ref": "#/$defs/launch"
      }
    },
    "analysis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/analysis"
        }
      ],
      "description": "Recomputed from plan and launches after every launch, by rhvp_compare.analyze or any tool that writes the same shape."
    }
  },
  "$defs": {
    "number_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "side": {
      "type": "object",
      "required": [
        "key",
        "name",
        "image",
        "preset",
        "args",
        "env",
        "gpu"
      ],
      "properties": {
        "key": {
          "enum": [
            "A",
            "B"
          ]
        },
        "name": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "preset": {
          "enum": [
            "vllm-openai",
            "ray-serve-llm",
            "guidellm-mock",
            "custom"
          ]
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gpu": {
          "type": "boolean"
        }
      }
    },
    "side_provenance": {
      "type": "object",
      "required": [
        "image",
        "image_digest",
        "server_version"
      ],
      "properties": {
        "image": {
          "type": "string",
          "description": "The reference from the config."
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ],
          "description": "repository@sha256:..., as the node pulled it."
        },
        "server_version": {
          "$ref": "#/$defs/server_version"
        }
      }
    },
    "server_version": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "vllm",
        "source"
      ],
      "properties": {
        "vllm": {
          "type": "string"
        },
        "source": {
          "enum": [
            "endpoint",
            "log"
          ],
          "description": "endpoint: GET /version; log: the server's start-up log."
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "metric",
        "label",
        "unit",
        "better",
        "kind",
        "concurrency",
        "role",
        "group"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(startup/(ready_s|first_answer_s)|c[0-9]+/(ttft_ms_median|itl_ms_median|output_tokens_per_s|tokens_per_joule\\[gpu\\]))$",
          "description": "<level>/<metric>: startup, or c<concurrency> for a load level. The key in every launch's values map."
        },
        "metric": {
          "type": "string",
          "description": "The figure, the same at every level; with the role it makes the default floor group."
        },
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "better": {
          "enum": [
            "lower",
            "higher"
          ]
        },
        "kind": {
          "enum": [
            "time",
            "rate",
            "efficiency"
          ],
          "description": "Picks the verdict words: FASTER/SLOWER for time, BETTER/WORSE for rate and efficiency (tokens per joule)."
        },
        "concurrency": {
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "enum": [
            "primary",
            "secondary"
          ],
          "description": "primary: in the corrected family (plan.analysis.primary); secondary: graded on an uncorrected p-value, descriptive only."
        },
        "group": {
          "type": "string",
          "description": "<role>:<metric>. A side's noise floor for a case is the largest over the cases of its group."
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "Everything fixed before the first launch, so the cases, the primary cases, alpha and the order of every launch are on record as declared.",
      "required": [
        "schema",
        "run_name",
        "run_id",
        "platform",
        "model",
        "sides",
        "lineup",
        "twins",
        "schedule",
        "rounds",
        "warmup",
        "launches",
        "balance",
        "server",
        "load",
        "energy",
        "analysis",
        "cases",
        "power"
      ],
      "properties": {
        "model": {
          "type": "object",
          "required": [
            "id",
            "source",
            "revision"
          ]
        },
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/side"
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "description": "Rounds; each launches every lineup entry once."
        },
        "warmup": {
          "type": "boolean"
        },
        "server": {
          "type": "object",
          "required": [
            "port",
            "ready_timeout_s",
            "warmup_timeout_s",
            "gpu_memory_utilization",
            "max_model_len",
            "seed",
            "first_answer_tokens"
          ]
        },
        "load": {
          "type": "object",
          "required": [
            "tool",
            "image",
            "concurrencies",
            "prompt_tokens",
            "output_tokens",
            "seconds_per_level",
            "seed",
            "request_format",
            "tokenizer",
            "timeout_s"
          ]
        },
        "energy": {
          "type": "object",
          "required": [
            "source",
            "label",
            "scope",
            "settle_s",
            "thanos_url",
            "min_samples"
          ],
          "properties": {
            "source": {
              "enum": [
                "dcgm",
                "nvidia-smi",
                "none"
              ]
            },
            "label": {
              "const": "GPU-only power"
            },
            "scope": {
              "const": "gpu"
            },
            "min_samples": {
              "type": "integer",
              "minimum": 2,
              "description": "No tokens per joule from fewer power samples (or energy-counter readings) in a level's window."
            }
          }
        },
        "analysis": {
          "type": "object",
          "required": [
            "rule",
            "rule_fields",
            "baseline",
            "subject",
            "ratio",
            "alpha",
            "primary"
          ],
          "properties": {
            "rule": {
              "const": "strict"
            },
            "rule_fields": {
              "type": "object"
            },
            "baseline": {
              "const": "A"
            },
            "subject": {
              "const": "B"
            },
            "ratio": {
              "const": "B/A"
            },
            "alpha": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "primary": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "The primary case ids, declared before the first launch."
            }
          }
        },
        "lineup": {
          "type": "array",
          "description": "The lineup in order: A, then its twin A~same, B, then B~same (twins as rounds.twins asks).",
          "items": {
            "type": "object",
            "required": [
              "key",
              "of",
              "twin_of",
              "name"
            ],
            "properties": {
              "key": {
                "enum": [
                  "A",
                  "A~same",
                  "B",
                  "B~same"
                ]
              },
              "of": {
                "enum": [
                  "A",
                  "B"
                ],
                "description": "The side this entry launches."
              },
              "twin_of": {
                "enum": [
                  "A",
                  "B",
                  null
                ]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "twins": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B"
            ]
          },
          "description": "The sides that have a twin."
        },
        "schedule": {
          "const": "rotate-reverse",
          "description": "Round r (from 1) over a lineup g of n entries: off = (r-1) % n, cyc = ((r-1) // n) % 2, order[k] = g[(k+off) % n], reversed when cyc is 1."
        },
        "launches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "round",
              "pos",
              "side",
              "of",
              "kind"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "round": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "null for a warm-up launch."
              },
              "pos": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Position in its round, from 1."
              },
              "side": {
                "enum": [
                  "A",
                  "A~same",
                  "B",
                  "B~same"
                ]
              },
              "of": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "kind": {
                "enum": [
                  "warmup",
                  "scored"
                ]
              }
            }
          }
        },
        "balance": {
          "type": "object",
          "required": [
            "balanced",
            "step",
            "pairs"
          ],
          "description": "Counted over the planned orders: every entry in every position equally often, and in every compared pair each first equally often with a zero sum of position differences. step: the smallest balanced round count."
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          },
          "description": "Every case the run reports, in report order; the correction counts only the primary ones."
        },
        "power": {
          "type": "object",
          "required": [
            "family_size",
            "min_rounds",
            "reachable",
            "both_twins",
            "must_agree",
            "max_primary_cases",
            "plain"
          ],
          "description": "What the planned rounds allow before any measurement: min_rounds is the smallest n with family_size * 2^(1-n) < alpha; must_agree how many rounds must then lean the same way; max_primary_cases the most primary cases this many rounds can give a verdict.",
          "properties": {
            "family_size": {
              "type": "integer"
            },
            "min_rounds": {
              "type": "integer"
            },
            "reachable": {
              "type": "boolean"
            },
            "both_twins": {
              "type": "boolean"
            },
            "must_agree": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_primary_cases": {
              "type": "integer"
            },
            "plain": {
              "type": "string"
            }
          }
        }
      }
    },
    "latency_summary": {
      "type": "object",
      "required": [
        "median",
        "p90",
        "mean",
        "count"
      ],
      "properties": {
        "median": {
          "$ref": "#/$defs/number_or_null"
        },
        "p90": {
          "$ref": "#/$defs/number_or_null"
        },
        "mean": {
          "$ref": "#/$defs/number_or_null"
        },
        "count": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "energy": {
      "type": "object",
      "required": [
        "source",
        "label",
        "method",
        "samples",
        "mean_power_w",
        "energy_j",
        "tokens_per_joule",
        "joules_per_token",
        "note"
      ],
      "properties": {
        "source": {
          "enum": [
            "dcgm",
            "nvidia-smi",
            "none"
          ]
        },
        "label": {
          "const": "GPU-only power"
        },
        "method": {
          "enum": [
            "energy_counter",
            "power_mean",
            null
          ],
          "description": "energy_counter: from the DCGM total-energy counter over the window; power_mean: the mean of the power samples in the window."
        },
        "samples": {
          "type": "integer"
        },
        "mean_power_w": {
          "$ref": "#/$defs/number_or_null"
        },
        "energy_j": {
          "$ref": "#/$defs/number_or_null"
        },
        "tokens_per_joule": {
          "$ref": "#/$defs/number_or_null"
        },
        "joules_per_token": {
          "$ref": "#/$defs/number_or_null"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "level": {
      "type": "object",
      "description": "One concurrency level of one launch, from GuideLLM's report.",
      "required": [
        "concurrency",
        "started_at",
        "finished_at",
        "start_epoch",
        "end_epoch",
        "duration_s",
        "requests",
        "ttft_ms",
        "itl_ms",
        "output_tokens",
        "output_tokens_per_s",
        "requests_per_s",
        "usable",
        "note"
      ],
      "properties": {
        "concurrency": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_epoch": {
          "$ref": "#/$defs/number_or_null"
        },
        "end_epoch": {
          "$ref": "#/$defs/number_or_null"
        },
        "duration_s": {
          "$ref": "#/$defs/number_or_null"
        },
        "requests": {
          "type": "object",
          "required": [
            "successful",
            "errored",
            "incomplete"
          ]
        },
        "ttft_ms": {
          "$ref": "#/$defs/latency_summary"
        },
        "itl_ms": {
          "$ref": "#/$defs/latency_summary"
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens_per_s": {
          "$ref": "#/$defs/number_or_null",
          "description": "Over the level's window, all requests (incomplete ones at the end included), as GuideLLM's server throughput."
        },
        "requests_per_s": {
          "$ref": "#/$defs/number_or_null"
        },
        "usable": {
          "type": "boolean",
          "description": "false when any request errored or none finished; the level's figures then stay out of the comparison."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "energy": {
          "$ref": "#/$defs/energy"
        }
      }
    },
    "breakdown_entry": {
      "type": "object",
      "required": [
        "phase",
        "label",
        "seconds",
        "at_s",
        "source"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "seconds": {
          "$ref": "#/$defs/number_or_null",
          "description": "A phase the server timed itself, in its own words."
        },
        "at_s": {
          "$ref": "#/$defs/number_or_null",
          "description": "When the line was written, in seconds since the launch asked for the server (node clock)."
        },
        "source": {
          "const": "log"
        },
        "count": {
          "type": "integer",
          "description": "How many lines were added up into seconds."
        }
      }
    },
    "launch": {
      "type": "object",
      "required": [
        "index",
        "round",
        "pos",
        "side",
        "of",
        "kind",
        "status",
        "error",
        "error_code",
        "started_at",
        "finished_at",
        "node",
        "image_digest",
        "server_version",
        "startup",
        "levels",
        "values",
        "artifacts",
        "start_retries"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "round": {
          "type": [
            "integer",
            "null"
          ],
          "description": "null for a warm-up launch."
        },
        "pos": {
          "type": [
            "integer",
            "null"
          ]
        },
        "side": {
          "enum": [
            "A",
            "A~same",
            "B",
            "B~same"
          ]
        },
        "of": {
          "enum": [
            "A",
            "B"
          ],
          "description": "The side launched; a twin launches its side."
        },
        "kind": {
          "enum": [
            "warmup",
            "scored"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ],
          "description": "ok, or failed with error and error_code."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "enum": [
            null,
            "GPU_NOT_FREE",
            "SIDE_FAILED",
            "SIDE_NEVER_READY",
            "LOAD_FAILED",
            "STOPPED",
            "RUNNER_ERROR"
          ],
          "description": "null when the launch is ok. GPU_NOT_FREE: another pod or program still held the GPU; SIDE_FAILED: the side failed (bad image, pull failure, no node, or the server exited); SIDE_NEVER_READY: no model listed, or no answer, before the time limit; LOAD_FAILED: GuideLLM failed or timed out after its one retry, or its report is unusable; STOPPED: the runner was stopped during the launch; RUNNER_ERROR: anything else (the platform's API, a fault in the runner)."
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_version": {
          "$ref": "#/$defs/server_version"
        },
        "startup": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "ready_s",
            "first_answer_s",
            "clock",
            "breakdown"
          ],
          "properties": {
            "ready_s": {
              "type": "number",
              "description": "From just before the runner asked for the server until GET /v1/models listed the model."
            },
            "first_answer_s": {
              "type": "number",
              "description": "From the same moment until the first generated text of a streamed completion."
            },
            "clock": {
              "type": "string"
            },
            "breakdown": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/breakdown_entry"
              }
            }
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "artifacts": {
          "type": "object",
          "description": "Paths relative to the run's folder.",
          "properties": {
            "server_log": {
              "type": "string"
            },
            "load_report": {
              "type": "string"
            },
            "server_log_attempt_1": {
              "type": "string",
              "description": "The server log of the start that stopped at vLLM's start-up memory check, when the side was started again."
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "How many times the side was started again in this launch after its server stopped at vLLM's start-up memory check ('Error in memory profiling'; a GPU whose memory is the machine's own fails it when another program frees memory while it measures). At most 1: a second such failure fails the launch (SIDE_FAILED). The start-up figures are timed from the last start."
        },
        "values": {
          "type": "object",
          "description": "The launch's figure for each case id in plan.cases that it measured. A 0, such as 0 output tokens per second, gives no ratio: that case gets NO VERDICT (nonpositive_value). The analysis reads only this map.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "One launch: one start of one server, as measured."
    },
    "comparison": {
      "type": "object",
      "description": "One case, side B (the subject) against side A (the baseline).",
      "required": [
        "case",
        "subject",
        "baseline",
        "role",
        "kind",
        "better",
        "group",
        "n_rounds",
        "n_unpaired",
        "n_untied",
        "n_lower",
        "n_higher",
        "subject_median",
        "baseline_median",
        "ratio",
        "gap",
        "ratios",
        "floor",
        "bar",
        "p_raw",
        "p_raw_fraction",
        "p_corrected",
        "order_split",
        "lost",
        "outcome",
        "reason",
        "verdict"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "subject": {
          "const": "B"
        },
        "baseline": {
          "const": "A"
        },
        "role": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "kind": {
          "enum": [
            "time",
            "rate",
            "efficiency"
          ]
        },
        "better": {
          "enum": [
            "lower",
            "higher"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "n_rounds": {
          "type": "integer",
          "description": "Rounds with both a B and an A figure."
        },
        "n_unpaired": {
          "type": "integer",
          "description": "Rounds with only one of the two."
        },
        "n_untied": {
          "type": "integer",
          "description": "Paired rounds where the figures differ: the sign test's trials."
        },
        "n_lower": {
          "type": "integer",
          "description": "Rounds with B/A below 1."
        },
        "n_higher": {
          "type": "integer",
          "description": "Rounds with B/A above 1."
        },
        "subject_median": {
          "$ref": "#/$defs/number_or_null"
        },
        "baseline_median": {
          "$ref": "#/$defs/number_or_null"
        },
        "ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "M, the median of B/A over the paired rounds (the mean of the two middle values for an even count)."
        },
        "gap": {
          "type": [
            "number",
            "null"
          ],
          "description": "abs(M - 1)."
        },
        "ratios": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "floor": {
          "type": "object",
          "required": [
            "source",
            "subject",
            "baseline",
            "mode"
          ],
          "properties": {
            "source": {
              "const": "twins"
            },
            "subject": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "value",
                "n",
                "provisional",
                "spread",
                "outlier_rounds",
                "case"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "abs(median(side / twin) - 1), the largest over the case's group."
                },
                "n": {
                  "type": "integer",
                  "description": "Rounds with both the side's and its twin's figure, for the case that set the value."
                },
                "provisional": {
                  "type": "boolean",
                  "description": "From fewer than 8 rounds."
                },
                "spread": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Interquartile range of side / twin over its median, for information."
                },
                "outlier_rounds": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "Rounds outside the Tukey fences; named, never dropped."
                },
                "case": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The case of the group whose floor is the largest."
                }
              }
            },
            "baseline": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "value",
                "n",
                "provisional",
                "spread",
                "outlier_rounds",
                "case"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "abs(median(side / twin) - 1), the largest over the case's group."
                },
                "n": {
                  "type": "integer",
                  "description": "Rounds with both the side's and its twin's figure, for the case that set the value."
                },
                "provisional": {
                  "type": "boolean",
                  "description": "From fewer than 8 rounds."
                },
                "spread": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Interquartile range of side / twin over its median, for information."
                },
                "outlier_rounds": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "Rounds outside the Tukey fences; named, never dropped."
                },
                "case": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The case of the group whose floor is the largest."
                }
              }
            },
            "mode": {
              "const": "TWO-SIDED"
            }
          }
        },
        "bar": {
          "type": [
            "number",
            "null"
          ],
          "description": "The subject's floor plus the baseline's; null without both."
        },
        "p_raw": {
          "type": [
            "number",
            "null"
          ],
          "description": "Exact two-sided sign test over the untied rounds; null for one paired round or none."
        },
        "p_raw_fraction": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "p_corrected": {
          "type": [
            "number",
            "null"
          ],
          "description": "Holm-adjusted over the primary cases with a p-value; null for a secondary case (graded on p_raw)."
        },
        "order_split": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[rounds where B ran before A, rounds where A ran first], over the paired rounds."
        },
        "lost": {
          "type": "object",
          "required": [
            "A",
            "B"
          ],
          "description": "Rounds a side lost through its own doing (its launch failed with SIDE_FAILED, SIDE_NEVER_READY or LOAD_FAILED, or requests failed at the case's level) while the other side did not; any makes the case NO VERDICT (side_failed)."
        },
        "outcome": {
          "enum": [
            "better",
            "worse",
            "tie",
            "unresolved",
            "no_verdict"
          ],
          "description": "What programs read, with reason."
        },
        "reason": {
          "enum": [
            null,
            "inside_noise",
            "not_significant",
            "order_unbalanced",
            "single_measurement",
            "too_few_rounds",
            "no_floor",
            "one_sided_floor",
            "zero_floor",
            "nonpositive_value",
            "order_not_recorded",
            "side_failed",
            "more_than_one_node"
          ],
          "description": "null for better, worse and tie. side_failed and more_than_one_node are this pattern's own."
        },
        "verdict": {
          "enum": [
            "FASTER",
            "SLOWER",
            "BETTER",
            "WORSE",
            "TIE",
            "UNRESOLVED",
            "NO VERDICT"
          ],
          "description": "The display word."
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "tool",
        "rule",
        "comparisons",
        "same_vs_same",
        "refusals",
        "notes",
        "outcomes",
        "nodes"
      ],
      "properties": {
        "tool": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "description": "What wrote this section."
        },
        "rule": {
          "type": "object",
          "required": [
            "name",
            "fields",
            "family_size",
            "plain",
            "min_rounds"
          ],
          "properties": {
            "name": {
              "const": "strict"
            },
            "fields": {
              "type": "object"
            },
            "family_size": {
              "type": "integer",
              "description": "Primary cases with a p-value: the size of Holm's family."
            },
            "plain": {
              "type": "string",
              "description": "corrected for testing N cases at once, or one case tested."
            },
            "min_rounds": {
              "type": "object",
              "required": [
                "primary",
                "secondary"
              ]
            }
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "same_vs_same": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "side",
              "twin",
              "case",
              "n",
              "ratio",
              "floor",
              "spread",
              "outlier_rounds",
              "provisional",
              "p_raw",
              "order_split"
            ]
          },
          "description": "Each side against its twin, per case: the median of side / twin, the floor it gives, and the uncorrected sign test (outside the family)."
        },
        "refusals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "scope",
              "message"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Loud notes, such as a side that differs from its own twin more often than chance."
        },
        "outcomes": {
          "type": "object",
          "required": [
            "primary",
            "secondary"
          ],
          "description": "Counts of each verdict word, by role."
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "description": "status.json in ConfigMap compare-<run id> (labels app.kubernetes.io/component=compare-run and compare-run-id=<run id>), next to result.json (the whole results file, left out above about 900 kB). Rewritten after every launch; written by summary.status.",
      "required": [
        "schema",
        "run_id",
        "phase",
        "error_code",
        "completed_rounds",
        "total_rounds",
        "launches_done",
        "launches_total",
        "launches_failed",
        "levels_unusable",
        "server_restored",
        "eta_seconds",
        "started_at",
        "finished_at",
        "sides",
        "primary",
        "outcomes",
        "results_file"
      ],
      "properties": {
        "schema": {
          "const": "rhvp-image-compare-status/2"
        },
        "run_id": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "running",
            "complete",
            "partial",
            "failed"
          ],
          "description": "run.status."
        },
        "error_code": {
          "$ref": "#/properties/run/properties/error_code"
        },
        "levels_unusable": {
          "type": "array",
          "description": "Load levels of finished launches left out of the comparison because requests failed there, or none finished.",
          "items": {
            "type": "object",
            "required": [
              "index",
              "round",
              "side",
              "kind",
              "concurrency",
              "errored",
              "successful"
            ]
          }
        },
        "server_restored": {
          "$ref": "#/properties/run/properties/server_restored"
        },
        "eta_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "description": "While running: the mean launch length so far times the launches left; otherwise null."
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "sides": {
          "type": "object"
        },
        "primary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case",
              "verdict",
              "outcome",
              "reason",
              "ratio",
              "bar",
              "p_corrected",
              "n_rounds"
            ]
          }
        },
        "outcomes": {
          "type": [
            "object",
            "null"
          ]
        },
        "results_file": {
          "type": "string",
          "description": "The results file's path under the results root."
        },
        "updated_at": {
          "type": "string",
          "description": "When this status was written (UTC)."
        },
        "completed_rounds": {
          "type": "integer",
          "description": "Rounds whose every launch ran (ok or failed)."
        },
        "total_rounds": {
          "type": "integer"
        },
        "launches_done": {
          "type": "integer"
        },
        "launches_total": {
          "type": "integer"
        },
        "launches_failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "round",
              "side",
              "kind",
              "error_code"
            ]
          }
        }
      }
    }
  }
}
